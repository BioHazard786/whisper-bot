# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCDefghIJKlmnoPQRstuvWXYZ

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Default: INFO)
LOG_LEVEL=INFO

# Application environment: development (console formatting) or production (JSON output)
APP_ENV=production

# Whisper expiration time in seconds before auto-cleanup (Default: 86400 = 24 hours)
DEFAULT_WHISPER_TTL_SECONDS=86400

# Periodic background eviction sweep interval in seconds (Default: 300 = 5 minutes)
CLEANUP_INTERVAL_SECONDS=300

# Minimum cooldown between callback clicks per user to prevent spam (Default: 0.3s)
RATE_LIMIT_SECONDS=0.3
